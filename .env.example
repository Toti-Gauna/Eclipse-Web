# WhatsApp en formato internacional, sin "+" ni espacios (placeholder).
NEXT_PUBLIC_WHATSAPP=5492230000000
# Email de contacto (placeholder).
NEXT_PUBLIC_EMAIL=hola@eclipse.example
# URL pública final, sin "/" al final. Se usa para canonical, hreflang, OG y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://toti-gauna.github.io/Eclipse-Web
# Prefijo de rutas. "/Eclipse-Web" en GitHub Pages; vacío en dominio propio.
NEXT_PUBLIC_BASE_PATH=/Eclipse-Web
# Backend (Eclipse-be). Vacío = el sitio funciona como hasta ahora (portal de demostración + WhatsApp).
# Origen absoluto sin "/" final. El modo "live" exige dominio propio: ver docs/integration.md.
NEXT_PUBLIC_API_BASE_URL=
# "live" conecta portal y solicitudes al backend (requiere NEXT_PUBLIC_API_BASE_URL). "demo" o vacío = fixtures.
NEXT_PUBLIC_PORTAL_MODE=demo
